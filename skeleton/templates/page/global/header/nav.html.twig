<nav class="nav" data-controller="header">
    <a href="{{ path('home') }}" class="nav-logo">ZZ<span>D</span>S</a>

    <div class="nav-links">
        {% for link in nav_links %}
            <a href="{{ link.route is defined ? path(link.route) : '#' }}"
               class="nav-link{{ link.active is defined and link.active ? ' active' : '' }}">
                {{ link.label }}
            </a>
        {% endfor %}
    </div>

    <div class="nav-disc">
        {% for disc in disciplines %}
            <span class="disc-pill{{ disc.active is defined and disc.active ? ' active' : '' }}"
                  data-discipline="{{ disc.label }}">
                {{ disc.label }}
            </span>
        {% endfor %}
    </div>

    <div class="nav-right">
        {% if is_logged_in is defined and is_logged_in %}
            <a href="{{ path('app_account') }}" class="btn-login">Account</a>
            <a href="{{ path('app_logout') }}" class="btn-login">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-login">Login</a>
        {% endif %}
    </div>
</nav>

{% if ticker_items is defined and ticker_items is not empty %}
    {% include 'components/ticker.html.twig' with { ticker_items: ticker_items } %}
{% endif %}
