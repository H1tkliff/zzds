{# components/rankings_table.html.twig
   Variables:
   - teams: array of App\Entity\Ranking (position, team, points, rating, snapshotDate)
   - meta: ?string (e.g. "Updated 24 Oct 2026")
#}
<div class="section-header">
    <div class="section-title">World Rankings</div>
    <div class="section-meta">{{ meta }}</div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Team</th>
            <th>Points</th>
            <th>Rating</th>
            <th>Δ</th>
        </tr>
    </thead>
    <tbody>
        {% for item in teams %}
            {% set ranking = item.ranking %}
            <tr>
                <td>
                    <div class="rank-num{{ ranking.position <= 3 ? ' top3' : '' }}">{{ ranking.position }}</div>
                </td>
                <td>
                    <a href="{{ path('cs2_team_show', {id: ranking.team.id, slug: ranking.team.slug}) }}" class="team-cell">{{ ranking.team.name }}</a>
                </td>
                <td class="points-val">{{ ranking.points }}</td>
                <td>
                    <div class="rating-cell">
                        <span class="rating-val">{{ ranking.rating }}</span>
                    </div>
                </td>
                <td>
                    {% if item.change is null or item.change == 0 %}
                        <span class="change same">—</span>
                    {% elseif item.change > 0 %}
                        <span class="change up">▲{{ item.change }}</span>
                    {% else %}
                        <span class="change down">▼{{ item.change|abs }}</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="widget-empty">No ranking yet</td></tr>
        {% endfor %}
    </tbody>
</table>
