{# components/sidebar/stats_widget.html.twig
   Variables:
   - stats: array of {val, label}
#}
<div class="widget">
    <div class="widget-title">Platform Stats</div>

    <div class="stats-grid">
        {% for stat in stats %}
            <div class="stat-box">
                <div class="stat-val">{{ stat.val }}</div>
                <div class="stat-label">{{ stat.label }}</div>
            </div>
        {% endfor %}
    </div>
</div>
