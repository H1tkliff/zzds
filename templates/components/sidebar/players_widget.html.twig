{# components/sidebar/players_widget.html.twig
   Variables:
   - players: array of App\Entity\Player (with team loaded)
#}
<div class="widget">
    <div class="widget-title">Top Players</div>

    {% for player in players %}
        <div class="player-row">
            <div class="player-rank">{{ loop.index }}</div>
            <div class="player-avatar">{{ player.nickname|slice(0, 2)|upper }}</div>
            <div class="player-info">
                <div class="player-nick">{{ player.nickname }}</div>
                <div class="player-team">{{ player.team.name }}</div>
            </div>
            <div class="player-rating">{{ player.rating|number_format(2) }}</div>
        </div>
    {% else %}
        <div class="widget-empty">No players yet</div>
    {% endfor %}
</div>
