{% extends 'base.html.twig' %}

{% block title %}Teams · ZZDS{% endblock %}

{% block nav %}{% endblock %}

{% block body %}
<div class="teams-wrap">

    <div class="page-head">
        <div class="page-title">
            Teams
            <small>{{ teams|length }} registered</small>
        </div>
    </div>

    <div class="teams-list" data-controller="teams">
        {% for team in teams %}
            <div class="team-featured{% if not loop.first %} is-close{% endif %}">
                <div class="tf-head">
                    <div class="tf-logo">{{ team.name|slice(0,3)|upper }}</div>
                    <div>
                        <div class="tf-name">{{ team.name }}</div>
                        {% if team.discipline is defined and team.discipline %}
                            <div class="tf-disc">{{ team.discipline.name }}</div>
                        {% endif %}
                    </div>
                    <a href="{{ path('team_show', {id: team.id}) }}" class="tf-link">View team →</a>
                    <div class="tf-chevron">▾</div>
                </div>
                <div class="tf-players-collapse">
                    <div class="tf-players">
                        {% for player in team.players %}
                            <div class="tf-player">
                                <div class="tf-avatar">{{ player.nickname|slice(0,2)|upper }}</div>
                                <div class="tf-nick">{{ player.nickname }}</div>
                                <div class="tf-rating">{{ player.rating|number_format(2) }}</div>
                            </div>
                        {% else %}
                            <span class="tf-empty">No players registered</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="teams-empty">No teams found.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}
