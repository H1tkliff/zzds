{% extends 'base.html.twig' %}

{% block title %}Sign In — ZZDS{% endblock %}

{% block header %}
<nav class="login-nav">
    <a href="{{ path('home') }}" class="nav-logo">ZZ<span>D</span>S</a>
    <a href="{{ path('discipline_cs2') }}" class="nav-back">← Back to matches</a>
</nav>
{% endblock %}

{% block nav %}{% endblock %}

{% block body %}
<div class="bg-grid"></div>
<div class="bg-glow"></div>
<div class="bg-glow2"></div>

<div class="login-page">
    <div class="login-card" data-controller="login">

        <div class="card-head">
            <div class="card-title">Welcome back</div>
            <div class="card-sub">Sign in to <span>ZZDS</span> · Track your teams, follow matches</div>
        </div>

        <div class="card-body">

            <div class="tabs">
                <span class="tab {{ active_tab|default('login') == 'login' ? 'active' }}" data-tab="login" data-action="click->login#switchTab">Sign In</span>
                <span class="tab {{ active_tab|default('login') == 'register' ? 'active' }}" data-tab="register" data-action="click->login#switchTab">Register</span>
            </div>

            {% include 'page/account/login/login.html.twig' %}

            {% include 'page/account/register/register.html.twig' %}

        </div>

        <div class="stats-row">
            <div class="stat-item">
                <div class="stat-val">48K</div>
                <div class="stat-lbl">Members</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">3</div>
                <div class="stat-lbl">Disciplines</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">312</div>
                <div class="stat-lbl">Teams</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">Free</div>
                <div class="stat-lbl">Always</div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
