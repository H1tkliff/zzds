{% extends 'base.html.twig' %}

{% block title %}Account · ZZDS{% endblock %}

{% block body %}
<div class="teams-wrap">
    <div class="page-head">
        <div class="page-title">
            {{ app.user.name }} {{ app.user.surname }}
            <small>{{ app.user.email }}</small>
        </div>
    </div>

    <table class="table">
        <tbody>
            <tr>
                <td>Name</td>
                <td>{{ app.user.name }} {{ app.user.surname }}</td>
            </tr>
            <tr>
                <td>Email</td>
                <td>{{ app.user.email }}</td>
            </tr>
            <tr>
                <td>Roles</td>
                <td>{{ app.user.roles|map(role => role|replace({'ROLE_': ''})|lower)|join(', ') }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_logout') }}" class="btn-login">Logout</a>
</div>
{% endblock %}
