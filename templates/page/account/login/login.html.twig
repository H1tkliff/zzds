<div id="form-login" style="{{ active_tab|default('login') == 'register' ? 'display:none' }}">
    {% if error %}
        <div class="login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <div class="field">
            <div class="field-label">Email Address</div>
            <div class="field-wrap">
                <div class="field-icon">@</div>
                <input class="field-input" type="email" name="email"
                       value="{{ last_username }}"
                       placeholder="you@example.com"
                       autocomplete="email" required autofocus>
            </div>
        </div>

        <div class="field">
            <div class="field-label">
                Password
                <a href="#">Forgot password?</a>
            </div>
            <div class="field-wrap">
                <div class="field-icon">⬡</div>
                <input class="field-input" type="password" name="password"
                       placeholder="••••••••"
                       autocomplete="current-password" required>
            </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="check-row">
            <div class="check-box"></div>
            <div class="check-label">Keep me signed in for 30 days</div>
            <input type="checkbox" name="_remember_me" style="display:none">
        </div>

        <button class="btn-submit" type="submit">Sign In</button>
    </form>

    <div class="divider">
        <div class="divider-line"></div>
        <div class="divider-text">or continue with</div>
        <div class="divider-line"></div>
    </div>

    <div class="oauth-row">
        <button class="btn-oauth" type="button"><span class="oauth-icon">◈</span> Steam</button>
        <button class="btn-oauth" type="button"><span class="oauth-icon">◉</span> Discord</button>
        <button class="btn-oauth" type="button"><span class="oauth-icon">◎</span> Google</button>
    </div>
</div>
