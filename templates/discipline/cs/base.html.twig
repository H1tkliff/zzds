<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}ZZDS — Esports Hub{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body>
{% block header %}
    {{ render(controller('App\\Controller\\HeaderController::header')) }}
{% endblock %}
{% block body %}

        <div class="layout">
            <div class="main">

                {# Live Matches #}
{#                <div class="mb16">#}
{#                    <div class="section-header">#}
{#                        <div class="live-dot"></div>#}
{#                        <div class="section-title">Live Matches</div>#}
{#                        <div class="section-meta">{{ live_matches|length }} ongoing</div>#}
{#                    </div>#}

{#                    {% for match in live_matches %}#}
{#                        {% include 'components/match_card.html.twig' with { match: match } %}#}
{#                    {% endfor %}#}
{#                </div>#}

                {# Upcoming Matches #}
{#                <div class="mb16">#}
{#                    <div class="section-header">#}
{#                        <div class="section-title">Upcoming</div>#}
{#                        <div class="section-meta">Today · {{ upcoming_matches|length }} matches</div>#}
{#                    </div>#}

{#                    {% for match in upcoming_matches %}#}
{#                        {% include 'components/upcoming_card.html.twig' with { match: match } %}#}
{#                    {% endfor %}#}
{#                </div>#}

                {# World Rankings #}
                <div class="mb16">
                    {% include 'components/rankings_table.html.twig' with {
                        teams: rankings,
                        meta: 'Updated 2h ago'
                    } %}
                </div>

            </div>

            <div class="sidebar">
                {% include 'components/sidebar/players_widget.html.twig' with {
                    players: top_players,
                    period: 'This Month'
                } %}

                {% include 'components/sidebar/events_widget.html.twig' with {
                    events: upcoming_events
                } %}

                {% include 'components/sidebar/stats_widget.html.twig' with {
                    stats: platform_stats
                } %}
            </div>
        </div>
{% endblock %}
</body>
</html>
